#!/usr/bin/env bash
# Stop hook: top-centre HUD when Claude finishes a turn.
set -uo pipefail

# -P resolves through the symlink install.sh leaves in ~/.claude, so the hook finds
# its siblings in the checkout rather than wherever it was invoked from.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

# Overridable so the test suite can point at a stub and assert on the arguments
# instead of flashing real windows.
case $(uname) in
  Darwin) os=mac ;;
  Linux)  os=linux ;;
  *)      os=other ;;
esac
# The macOS HUD is AppKit and the Linux one is GTK4 on a layer-shell surface; they
# take the same flags, so everything below this line is platform-neutral.
default_hud=$here/bin/claude-hud
[[ $os == linux ]] && default_hud=$here/bin/claude-hud-gtk
HUD=${CLAUDE_HUD_BIN:-$default_hud}
SECONDS_SHOWN=${CLAUDE_NOTIFY_SECONDS:-5}
SOUND=${CLAUDE_NOTIFY_SOUND:-Glass}
VOLUME=${CLAUDE_NOTIFY_VOLUME:-1.0}

JQ=$(command -v jq || echo /opt/homebrew/bin/jq)
[[ -x $JQ ]] || exit 0

RUNTIME=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
# Overridable so the suite gets its own queue instead of racing a live one.
QUEUE=${CLAUDE_NOTIFY_DEFER_QUEUE:-$RUNTIME/claude-hud-deferred.jsonl}
LOCK=$QUEUE.lock

# Is the window you are looking at covering the screen? Hyprland answers with a
# bitmask: 1 maximized, 2 fullscreen, 3 both. Only the fullscreen bit counts — a
# maximized window is still a window, and the HUD belongs over it.
focused_fullscreen() {
  [[ $os == linux ]] || return 1
  local fsmode=0
  if command -v hyprctl >/dev/null 2>&1; then
    fsmode=$("$JQ" -r '.fullscreen // 0' <<<"$(hyprctl activewindow -j 2>/dev/null)" 2>/dev/null)
  elif command -v swaymsg >/dev/null 2>&1; then
    swaymsg -t get_tree 2>/dev/null \
      | "$JQ" -e 'first(.. | select(.focused? == true) | select((.fullscreen_mode? // 0) > 0))' \
        >/dev/null 2>&1 && fsmode=2
  fi
  [[ ${fsmode:-0} =~ ^[0-9]+$ ]] && (( fsmode & 2 ))
}

in_do_not_disturb() {
  [[ $os == linux ]] || return 1
  # Every installed daemon is asked: a leftover binary must not hide the running one.
  if command -v omarchy-shell >/dev/null 2>&1; then
    [[ $(omarchy-shell notifications isDnd 2>/dev/null) == on ]] && return 0
  fi
  if command -v makoctl >/dev/null 2>&1; then
    # mako modes are arbitrary user strings; do-not-disturb is the convention.
    makoctl mode 2>/dev/null | grep -qxF "${CLAUDE_NOTIFY_DND_MODE:-do-not-disturb}" && return 0
  fi
  if command -v dunstctl >/dev/null 2>&1; then
    [[ $(dunstctl is-paused 2>/dev/null) == true ]] && return 0
  fi
  if command -v swaync-client >/dev/null 2>&1; then
    [[ $(swaync-client --get-dnd 2>/dev/null) == true ]] && return 0
  fi
  return 1
}

# The one question the watcher keeps re-asking: is now still a bad time?
should_defer() {
  [[ ${CLAUDE_NOTIFY_ALWAYS:-0} == 1 ]] && return 1
  [[ ${CLAUDE_NOTIFY_SKIP_FULLSCREEN:-1} == 1 ]] || return 1
  focused_fullscreen
}

emit_hud() {                   # emit_hud <hud args...>
  [[ -x $HUD ]] || return 0
  "$HUD" "$@" >/dev/null 2>&1 &
  # Detached: the hook must not sit for the HUD's whole display time. Its 10s
  # timeout would otherwise cut a 12s blocked notification short.
  disown 2>/dev/null || true
}

emit_banner() {                # emit_banner <headline> <subtitle> <body> <group> <event> <pane>
  [[ ${CLAUDE_NOTIFY_NATIVE:-1} == 1 ]] || return 0
  local headline=$1 subtitle=$2 text=$3 group=$4 ev=$5 pane=$6
  [[ ${CLAUDE_NOTIFY_DEBUG:-0} == 1 ]] && echo "notify-stop: banner=[$text]" >&2
  local NOTIFIER; NOTIFIER=$(command -v terminal-notifier || true)
  local args=()
  if [[ $os == linux ]] && command -v notify-send >/dev/null 2>&1; then
    # x-canonical-private-synchronous is the freedesktop counterpart of
    # terminal-notifier's -group: a second banner for the same pane replaces the
    # first instead of stacking another copy in the tray.
    args=(-a "Claude Code"
          -u "$([[ $ev == Notification ]] && echo critical || echo normal)"
          -h "string:x-canonical-private-synchronous:$group"
          -h "string:desktop-entry:claude-code")
    [[ -n ${CLAUDE_NOTIFY_ICON:-} ]] && args+=(-i "$CLAUDE_NOTIFY_ICON")
    if [[ -n $pane ]]; then
      # --wait blocks for the life of the banner and then prints the key of
      # whatever was pressed, so the whole thing is detached and acts afterwards.
      (
        chosen=$(notify-send "${args[@]}" -A "focus=Open ${group#claude-code-}" --wait \
                   "$headline" "$subtitle"$'\n'"$text" 2>/dev/null)
        [[ $chosen == focus ]] && "$here/focus-pane" "$pane" "$group"
      ) >/dev/null 2>&1 &
    else
      notify-send "${args[@]}" "$headline" "$subtitle"$'\n'"$text" >/dev/null 2>&1 &
    fi
  elif [[ -n $NOTIFIER ]]; then
    # terminal-notifier can run a command on click; osascript cannot.
    args=(-title "$headline" -subtitle "$subtitle" -message "$text" -group "$group")
    [[ -n $pane ]] && args+=(-execute "$here/focus-pane $pane $group")
    [[ -n ${CLAUDE_NOTIFY_NATIVE_SOUND:-} ]] && args+=(-sound "$CLAUDE_NOTIFY_NATIVE_SOUND")
    "$NOTIFIER" "${args[@]}" >/dev/null 2>&1 &
  elif [[ $os == mac ]]; then
    /usr/bin/osascript - "$headline" "$subtitle" "$text" >/dev/null 2>&1 <<'APPLESCRIPT' &
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
APPLESCRIPT
  fi
  disown 2>/dev/null || true
}

queue_push() {                 # queue_push <headline> <subtitle> <body> <group> <event> <pane> <hud args...>
  local headline=$1 subtitle=$2 text=$3 group=$4 ev=$5 pane=$6; shift 6
  mkdir -p "$(dirname "$QUEUE")" 2>/dev/null
  # The -- matters: the card's own flags start with --title, which jq would
  # otherwise try to parse as its own options.
  "$JQ" -nc --arg h "$headline" --arg s "$subtitle" --arg t "$text" \
        --arg g "$group" --arg e "$ev" --arg p "$pane" --args \
        '{banner:{headline:$h,subtitle:$s,text:$t,group:$g,event:$e,pane:$p},hud:$ARGS.positional}' \
        -- "$@" >>"$QUEUE" 2>/dev/null
  # A long session should not replay an unbounded stack; drop the oldest.
  local cap=${CLAUDE_NOTIFY_DEFER_MAX:-20}
  if [[ $(wc -l <"$QUEUE" 2>/dev/null || echo 0) -gt $cap ]]; then
    tail -n "$cap" "$QUEUE" >"$QUEUE.trim" 2>/dev/null && mv -f "$QUEUE.trim" "$QUEUE"
  fi
}

flush_queue() {
  local pending=$QUEUE.flushing
  mv -f "$QUEUE" "$pending" 2>/dev/null || return 0
  local first=1 line
  # Oldest first, so the newest ends up on top of the stack.
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    local hud=() b=()
    mapfile -t hud < <("$JQ" -r '.hud[]' <<<"$line" 2>/dev/null)
    mapfile -t b < <("$JQ" -r '.banner | .headline, .subtitle, .text, .group, .event, .pane' \
                       <<<"$line" 2>/dev/null)
    [[ ${#hud[@]} -gt 0 ]] || continue
    emit_banner "${b[0]-}" "${b[1]-}" "${b[2]-}" "${b[3]-}" "${b[4]-}" "${b[5]-}"
    # One chime for the whole batch, not one per turn you missed.
    [[ $first == 1 ]] && first=0 || hud+=(--sound none)
    emit_hud "${hud[@]}"
    sleep 0.15
  done <"$pending"
  rm -f "$pending"
}

# Spawned when a turn is deferred: waits for the screen to be yours again, then
# replays everything that piled up. mkdir is the lock, so sixteen panes finishing
# inside a game still leave exactly one watcher.
watch_and_flush() {
  mkdir "$LOCK" 2>/dev/null || return 0
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
  local poll=${CLAUDE_NOTIFY_DEFER_POLL:-3}
  local waited=0 limit=${CLAUDE_NOTIFY_DEFER_MAX_WAIT:-86400}
  while (( waited < limit )); do
    sleep "$poll"
    waited=$(( waited + poll ))
    [[ -s $QUEUE ]] || return 0
    should_defer || { flush_queue; return 0; }
  done
  flush_queue                  # gave up waiting; late beats never
}

ensure_watcher() {
  [[ -d $LOCK ]] && return 0
  setsid "$here/notify-stop" --flush-watch >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
}

if [[ ${1:-} == --flush-watch ]]; then
  watch_and_flush
  exit 0
fi

input=$(cat)
transcript=$("$JQ" -r '.transcript_path // empty' <<<"$input" 2>/dev/null)
cwd=$("$JQ" -r '.cwd // empty' <<<"$input" 2>/dev/null)
event=$("$JQ" -r '.hook_event_name // "Stop"' <<<"$input" 2>/dev/null)
# The field carrying the notification text is not documented, so try the plausible
# names and fall back to the event type, which the matcher guarantees is one of the
# "needs you" kinds. CLAUDE_NOTIFY_CAPTURE=1 records raw payloads to confirm it.
notice=$("$JQ" -r '.message // .notification // .text // .title // empty' <<<"$input" 2>/dev/null)
kind=$("$JQ" -r '.matcher // .notification_type // .type // empty' <<<"$input" 2>/dev/null)
if [[ -z $notice ]]; then
  case $kind in
    permission_prompt) notice="Needs your permission to continue." ;;
    idle_prompt)       notice="Waiting for your next instruction." ;;
    agent_needs_input) notice="An agent needs your input." ;;
    elicitation*)      notice="Waiting on a dialog." ;;
    *)                 notice="" ;;
  esac
fi
if [[ ${CLAUDE_NOTIFY_CAPTURE:-0} == 1 ]]; then
  capture=$here/notification-payloads.jsonl
  printf '%s\n' "$input" >>"$capture" 2>/dev/null
  tail -n 40 "$capture" >"$capture.tmp" 2>/dev/null && mv -f "$capture.tmp" "$capture" 2>/dev/null
fi
cwd=${cwd:-$PWD}

# Skip entirely when you are already looking at this pane: it is on screen in an
# attached session, the terminal is frontmost, and the screen is not locked.
# A pane can be pane_active in a window nobody is viewing, so window_active and
# session_attached both matter; a locked screen means you walked away.
if [[ ${CLAUDE_NOTIFY_ALWAYS:-0} != 1 && -n ${TMUX_PANE:-} ]]; then
  onscreen=$(tmux display-message -p -t "$TMUX_PANE" \
    '#{pane_active} #{window_active} #{session_attached}' 2>/dev/null)
  set -- $onscreen
  if [[ ${1:-0} == 1 && ${2:-0} == 1 && ${3:-0} -ge 1 ]]; then
    if [[ $os == mac ]]; then
      front=$(lsappinfo info -only name "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
        | sed -E 's/.*"LSDisplayName"="([^"]*)".*/\1/')
      locked=$(ioreg -n Root -d1 -k CGSSessionScreenIsLocked 2>/dev/null \
        | grep -c '"CGSSessionScreenIsLocked" = Yes')
      terminal=${CLAUDE_TERMINAL_APP:-Ghostty}
    else
      # The Wayland equivalents: the focused toplevel's app id, and whether a
      # screen locker holds the session. Both are best-effort — an unknown
      # compositor leaves front empty, which just means the HUD always shows.
      if command -v hyprctl >/dev/null 2>&1; then
        front=$("$JQ" -r '.class // empty' <<<"$(hyprctl activewindow -j 2>/dev/null)" 2>/dev/null)
      elif command -v swaymsg >/dev/null 2>&1; then
        front=$(swaymsg -t get_tree 2>/dev/null \
          | "$JQ" -r '.. | select(.focused? == true) | .app_id // .window_properties.class // empty' 2>/dev/null | head -1)
      else
        front=""
      fi
      locked=0
      pgrep -x hyprlock >/dev/null 2>&1 && locked=1
      pgrep -x swaylock >/dev/null 2>&1 && locked=1
      [[ $(omarchy-shell lock isLocked 2>/dev/null) == true ]] && locked=1
      [[ $(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null) == yes ]] && locked=1
      terminal=${CLAUDE_TERMINAL_APP:-com.mitchellh.ghostty}
    fi
    if [[ -n $front && $front == "$terminal" && ${locked:-0} == 0 ]]; then
      [[ ${CLAUDE_NOTIFY_DEBUG:-0} == 1 ]] && echo "notify-stop: skipped, you are watching this pane" >&2
      exit 0
    fi
  fi
fi

# Two ways a turn can be held back, both Linux-only — macOS has no probe for either
# that does not want accessibility permission. CLAUDE_NOTIFY_ALWAYS=1 overrides
# both, as it does the watching-the-pane check.
#
#   defer       nothing is shown now. The turn is queued and replayed when the
#               screen is yours again. For a fullscreen window — a game, a film —
#               where the banner is as unwelcome as the card: mako draws on the
#               overlay layer too, so it lands over the game just the same.
#   suppressed  the card and its chime go, the banner still posts. For
#               do-not-disturb, where the daemon already decides what to show.
defer_turn=0
hud_suppressed=0
suppress_reason=""

if [[ ${CLAUDE_NOTIFY_ALWAYS:-0} != 1 && $os == linux ]]; then
  if should_defer; then
    defer_turn=1
    suppress_reason="the focused window is fullscreen; queued for later"
  elif [[ ${CLAUDE_NOTIFY_SKIP_DND:-1} == 1 ]] && in_do_not_disturb; then
    hud_suppressed=1
    suppress_reason="your notification daemon is in do-not-disturb"
  fi
fi

if [[ -n $suppress_reason && ${CLAUDE_NOTIFY_DEBUG:-0} == 1 ]]; then
  echo "notify-stop: HUD held back, $suppress_reason" >&2
fi

# A git pull can bring a newer source than the compiled binary, and nothing else
# would notice. Rebuild into a temp file and swap only on success, so a broken
# source never destroys a working binary. The lock stops sixteen panes racing.
# The Linux backend is a script: nothing to compile, and it is never stale.
build_error=""
src=$HUD.swift
if [[ $os == mac && -f $src ]] && { [[ ! -x $HUD ]] || [[ $src -nt $HUD ]]; }; then
  if ! command -v swiftc >/dev/null 2>&1; then
    [[ ${CLAUDE_NOTIFY_DEBUG:-0} == 1 ]] && echo "notify-stop: rebuild skipped, no swiftc" >&2
  else
    lock=${TMPDIR:-/tmp}/claude-hud-build.lock
    if ! mkdir "$lock" 2>/dev/null; then
      [[ ${CLAUDE_NOTIFY_DEBUG:-0} == 1 ]] && echo "notify-stop: rebuild skipped, $lock held" >&2
    else
      trap 'rm -rf "$lock" 2>/dev/null' EXIT
      if swiftc -O -o "$HUD.new" "$src" 2>"$lock/err"; then
        mv -f "$HUD.new" "$HUD"
      else
        rm -f "$HUD.new"
        build_error=$(grep -m1 'error:' "$lock/err" 2>/dev/null | sed 's/^.*error: //')
        build_error=${build_error:-claude-hud.swift failed to compile}
      fi
    fi
  fi
fi

[[ -x $HUD ]] || exit 0

repo=$(basename "$cwd")
branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)

badge=""
if [[ -n ${TMUX_PANE:-} ]]; then
  badge=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)
fi

title="" body=""
if [[ -n $transcript && -r $transcript ]]; then
  title=$("$JQ" -r 'select(.type=="ai-title") | .aiTitle' "$transcript" 2>/dev/null | tail -n 1)
  body=$("$JQ" -r 'select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text | gsub("\\s+"; " ")' \
      "$transcript" 2>/dev/null \
    | sed -e 's/^ *//' -e '/^$/d' \
    | tail -n 1 \
    | sed -E -e 's/`+//g' -e 's/(^|[[:space:]])#+[[:space:]]+/\1/g' -e 's/\*+//g' \
    | awk '{ print (length($0) > 180) ? substr($0, 1, 179) "…" : $0 }')
fi

# A blocked session is structurally different, not just a different colour: no
# portrait, a deep-red rail and its own glyph, so it cannot be misread as "done".
if [[ $event == Notification ]]; then
  glyph="⏸"
  body=${notice:-Waiting on you.}
  hud_extra=(--avatar none --accent "${CLAUDE_NOTIFY_BLOCKED_ACCENT:-#96000E}")
  SECONDS_SHOWN=${CLAUDE_NOTIFY_BLOCKED_SECONDS:-12}
  SOUND=${CLAUDE_NOTIFY_BLOCKED_SOUND:-Funk}
else
  glyph="✳"
  hud_extra=()
fi

if [[ -n $build_error ]]; then
  glyph="⚠"
  body="HUD rebuild failed — showing the previous build. $build_error"
  hud_extra=(--avatar none --accent "#96000E")
  SECONDS_SHOWN=${CLAUDE_NOTIFY_BLOCKED_SECONDS:-12}
fi

# Build the card once; it is either shown now or stored verbatim for the replay.
hud_args=(
  --title "$glyph ${title:-$repo}"
  --badge "$badge"
  --repo "$repo"
  --branch "$branch"
  --body "${body:-Turn complete.}"
  --seconds "$SECONDS_SHOWN"
  --sound "$SOUND"
  --volume "$VOLUME"
)
[[ -n ${CLAUDE_NOTIFY_ACCENT:-} ]] && hud_args+=(--accent "$CLAUDE_NOTIFY_ACCENT")
[[ -n ${CLAUDE_NOTIFY_MEMBER:-} ]] && hud_args+=(--member "$CLAUDE_NOTIFY_MEMBER")
[[ -n ${TMUX_PANE:-} ]] && hud_args+=(--on-click "$here/focus-pane $TMUX_PANE claude-code-${badge:-$repo}")
hud_args+=(${hud_extra[@]+"${hud_extra[@]}"})

# The banner is transient and already on your screen; this one persists in the
# tray, so it carries no message text by default. A turn that discussed a token or
# a .env path would otherwise leave it sitting outside the terminal. Opt back in
# with CLAUDE_NOTIFY_NATIVE_BODY=1.
headline="$glyph ${title:-$repo}"
subtitle="${badge:+$badge · }$repo${branch:+ · $branch}"
group="claude-code-${badge:-$repo}"
if [[ ${CLAUDE_NOTIFY_NATIVE_BODY:-0} == 1 ]]; then
  banner=${body:-Turn complete.}
elif [[ $event == Notification ]]; then
  banner="Waiting on you${badge:+ — open $badge}"
else
  banner="Finished${badge:+ — open $badge}"
fi

if [[ $defer_turn == 1 ]]; then
  queue_push "$headline" "$subtitle" "$banner" "$group" "$event" "${TMUX_PANE:-}" "${hud_args[@]}"
  ensure_watcher
  exit 0
fi

emit_banner "$headline" "$subtitle" "$banner" "$group" "$event" "${TMUX_PANE:-}"
[[ $hud_suppressed == 1 ]] && exit 0
emit_hud "${hud_args[@]}"
exit 0
